{
    "name": "symfony/ux-html",
    "description": "HTML Attributes - PHP library to manage HTML attributes - A Symfony UX Library",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "symfony-ux",
        "symfony",
        "ux",
        "html",
        "attributes",
        "class",
        "html-attributes",
        "html-classes",
        "styles",
        "twig"
    ],
    "authors": [
        {
            "name": "Simon André",
            "email": "smn.andre@gmail.com"
        }
    ],
    "homepage": "https://ux.symfony.com",
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.2.3",
        "symfony/framework-bundle": "^7.2",
        "symfony/phpunit-bridge": "7.2",
        "symfony/stimulus-bundle": "^2.22",
        "symfony/twig-bundle": "^7.2",
        "phpstan/phpstan": "^2.1"
    },
    "minimum-stability": "dev",
    "autoload": {
        "psr-4": {
            "Symfony\\UX\\Html\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Symfony\\UX\\Html\\Tests\\": "tests/"
        }
    },
    "extra": {
        "thanks": {
            "name": "symfony/ux",
            "url": "https://github.com/symfony/ux"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-text --coverage-clover=coverage.clover",
        "phpstan": "PHPSTAN_DISABLE_PARALLEL=1 phpstan analyse --xdebug src/"
    }
}
